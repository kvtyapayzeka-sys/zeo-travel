# Database
# Runtime: Supabase transaction pooler (port 6543)
DATABASE_URL="postgresql://postgres.project-ref:password@pooler-host:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrations: Supabase session pooler/direct connection (port 5432)
DIRECT_URL="postgresql://postgres.project-ref:password@pooler-host:5432/postgres"

# NextAuth
NEXTAUTH_SECRET="generate-random-secret-here-use-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Initial admin (used only by prisma seed)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-at-least-12-characters"
ADMIN_EMAIL="operations@example.com"

# Supabase (optional - for direct access)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Email (future integration)
# EMAIL_PROVIDER="mailersend"
# MAILERSEND_API_KEY="mlsn..."
# EMAIL_FROM="ZEO Travel <rezervasyon@example.com>"
# EMAIL_PROVIDER="ses"
# AWS_REGION="eu-central-1"
# AWS_ACCESS_KEY_ID="..."
# AWS_SECRET_ACCESS_KEY="..."

# Payment Gateway (future - İyzico)
# IYZICO_API_KEY="your-api-key"
# IYZICO_SECRET_KEY="your-secret-key"
# IYZICO_BASE_URL="https://sandbox-api.iyzipay.com" # production: https://api.iyzipay.com

# Redis (optional - for caching)
# UPSTASH_REDIS_URL="https://..."
# UPSTASH_REDIS_TOKEN="..."

# Monitoring
# NEXT_PUBLIC_SENTRY_DSN="..."
# SENTRY_AUTH_TOKEN="..."

# NODE_ENV is managed by Next.js; do not set it manually.
