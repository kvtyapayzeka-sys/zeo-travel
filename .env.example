# Database
# Supabase PostgreSQL connection (with connection pooling for serverless)
DATABASE_URL="postgresql://user:password@host:5432/database?pgbouncer=true&connection_limit=1"

# NextAuth
NEXTAUTH_SECRET="generate-random-secret-here-use-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Supabase (optional - for direct access)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Email (future integration)
# RESEND_API_KEY="re_..."
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@example.com"
# SMTP_PASS="your-password"

# Payment Gateway (future - İyzico)
# IYZICO_API_KEY="your-api-key"
# IYZICO_SECRET_KEY="your-secret-key"
# IYZICO_BASE_URL="https://sandbox-api.iyzipay.com" # production: https://api.iyzipay.com

# Redis (optional - for caching)
# UPSTASH_REDIS_URL="https://..."
# UPSTASH_REDIS_TOKEN="..."

# Monitoring
# NEXT_PUBLIC_SENTRY_DSN="..."
# SENTRY_AUTH_TOKEN="..."

# Development
NODE_ENV="development"
